# Dependencies (regenerable — see README.md "Rebuilding after content changes")
node_modules/
.venv/

# SSG build caches (regenerable; the deployed build output lives at the
# project root: astro/, docusaurus/, mkdocs/, vitepress/)
demos/vitepress/docs/.vitepress/cache/
demos/docusaurus/.docusaurus/

# OS / editor noise
.DS_Store
*.swp

# NOTE: the top-level astro/, docusaurus/, mkdocs/, vitepress/ directories
